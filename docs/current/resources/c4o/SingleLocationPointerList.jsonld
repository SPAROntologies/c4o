      }
    ],
    "http://www.w3.org/2008/05/skos#note": [
      {
        "@language": "en",
        "@value": "A single location pointer list pertains to two or more references occurring at a single location in the text of the citing work - e.g. '[3,4,9]' or '[7-12]'."
      }
    ]
